{
  "manifest_version": 3,
  "name": "ScrollSync",
  "version": "1.1.0",
  "description": "Hands-free reading: steady auto-scroll, timed clicks for galleries and comics, and gamepad control.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "icon.png", "icon.svg", "guide.html", "about.html", "assets/*", "fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
